# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any Postgres works. PostGIS is optional and auto-detected (see GEO_BACKEND).
DATABASE_URL="postgres://localhost:5432/pour_finder"

# auto | postgis | haversine
#   auto      - probe for PostGIS at boot, use it if present (default)
#   postgis   - require PostGIS, fail loudly if missing
#   haversine - always use the portable bbox + haversine path
GEO_BACKEND="auto"

# ---------------------------------------------------------------------------
# Map
# ---------------------------------------------------------------------------
# Any MapLibre-compatible style URL. Defaults to CARTO Positron (no API key).
# MapTiler:   https://api.maptiler.com/maps/dataviz-light/style.json?key=YOUR_KEY
# Protomaps:  see docs/ARCHITECTURE.md for self-hosting
NEXT_PUBLIC_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
NEXT_PUBLIC_MAP_STYLE_URL_DARK="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"

# ---------------------------------------------------------------------------
# Geocoding (for "search by city / ZIP / address")
# ---------------------------------------------------------------------------
# gazetteer | nominatim
#   gazetteer - built-in offline table of US cities + ZIPs (zero cost, no network)
#   nominatim - OpenStreetMap Nominatim; REQUIRES a contact email per their policy
GEOCODER="gazetteer"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
NOMINATIM_CONTACT_EMAIL=""

# ---------------------------------------------------------------------------
# Community submissions / abuse prevention
# ---------------------------------------------------------------------------
# Rotated periodically. Anonymous contributor hashes are derived from this, so
# rotating it un-links historical hashes by design (privacy feature, not a bug).
SUBMITTER_HASH_SALT="change-me-in-production"

# Set to "true" to publish community submissions immediately without review.
# Appropriate for a solo operator seeding a new market; NOT for open traffic.
MODERATION_AUTO_APPROVE="false"

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Shared secret for /admin. Leave empty to disable the admin surface entirely.
ADMIN_TOKEN=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Moderation escalation (optional)
# ---------------------------------------------------------------------------
# When enough INDEPENDENT people comment that a deal has ended or a bar has
# closed, Pour Finder opens a moderation task. Community reports never change
# live data on their own - a human (or an agent assigned to the issue) decides.

# How many distinct reporters are needed before a task opens. Default 2.
ESCALATION_THRESHOLD="2"

# --- Optional: mirror moderation tasks as GitHub issues ---------------------
# Fine-grained PAT with Issues: read & write on the repo below.
GITHUB_TOKEN=""
GITHUB_REPO="CydVilla/pour-finder"
GITHUB_ISSUE_LABELS="pour-finder,data-review"
# Comma-separated GitHub logins to assign. Add `Copilot` to hand the task to
# the Copilot coding agent - that requires a PAID Copilot plan with the coding
# agent enabled for the repo. If assignment is rejected, the issue is still
# filed without an assignee.
GITHUB_ISSUE_ASSIGNEES=""

# Shared secret for the GitHub Action -> app callback that applies a decision
# when the issue is closed. Must match POUR_FINDER_WEBHOOK_SECRET in the repo's
# Actions secrets. Minimum 16 characters; leave empty to disable the endpoint.
MODERATION_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Media uploads (photos + video) — optional
# ---------------------------------------------------------------------------
# Two providers are supported; R2 wins when both are set.
#
# 1. Vercel Blob (default in production) — no configuration needed here. The
#    token is injected into the project by `vercel blob create-store`, so it
#    never has to be copied by hand. ~1 GB free, metered egress.
#
# 2. Cloudflare R2 — 10 GB free and no egress fees, which matters once video
#    volume grows. Needs R2 enabled on the account and an S3 API token, plus a
#    CORS rule allowing PUT from your origin. Leave blank to stay on Blob.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="pour-finder-media"
# Public read URL for the bucket (an r2.dev subdomain or your own CDN domain).
R2_PUBLIC_BASE_URL=""

# Publish uploads without review. Solo-operator mode only — anonymous image
# uploads on an alcohol site need a human in front of them once traffic is real.
MEDIA_AUTO_APPROVE="false"

# ---------------------------------------------------------------------------
# Advertising — optional. READ docs/ADS.md FIRST.
# ---------------------------------------------------------------------------
# Turning ads on makes the site commercial, which changes what your current
# free hosting and map tiles permit. Both must be dealt with first.
NEXT_PUBLIC_ADS_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT=""
